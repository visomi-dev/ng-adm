{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/core/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/core/**/*.ts",
              "projects/core/**/*.html"
            ],
            "eslintConfig": "projects/core/eslint.config.js"
          }
        }
      }
    },
    "express": {
      "projectType": "library",
      "root": "projects/express",
      "sourceRoot": "projects/express/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/express/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/express/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/express/tsconfig.spec.json",
            "externalDependencies": [
              "@ng-adm/core",
              "express",
              "express-session",
              "crypto",
              "fs",
              "path",
              "util",
              "events",
              "http",
              "url",
              "querystring",
              "buffer",
              "stream",
              "zlib",
              "string_decoder",
              "node:http",
              "node:path",
              "node:fs",
              "node:events",
              "node:net",
              "node:zlib",
              "mime-types",
              "on-headers",
              "parseurl",
              "random-bytes",
              "raw-body",
              "router",
              "safe-buffer",
              "safer-buffer",
              "send",
              "serve-static"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/express/**/*.ts",
              "projects/express/**/*.html"
            ],
            "eslintConfig": "projects/express/eslint.config.js"
          }
        }
      }
    },
    "prisma": {
      "projectType": "library",
      "root": "projects/prisma",
      "sourceRoot": "projects/prisma/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/prisma/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/prisma/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/prisma/tsconfig.spec.json",
            "externalDependencies": [
              "@ng-adm/core",
              "@prisma/client",
              "prisma",
              "crypto",
              "fs",
              "path",
              "util",
              "events",
              "http",
              "url",
              "querystring",
              "buffer",
              "stream",
              "zlib",
              "string_decoder",
              "node:http",
              "node:path",
              "node:fs",
              "node:events",
              "node:net",
              "node:zlib"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/prisma/**/*.ts",
              "projects/prisma/**/*.html"
            ],
            "eslintConfig": "projects/prisma/eslint.config.js"
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ui/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ui/**/*.ts",
              "projects/ui/**/*.html"
            ],
            "eslintConfig": "projects/ui/eslint.config.js"
          }
        }
      }
    },
    "page-builder": {
      "projectType": "library",
      "root": "projects/page-builder",
      "sourceRoot": "projects/page-builder/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/page-builder/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/page-builder/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/page-builder/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/page-builder/**/*.ts",
              "projects/page-builder/**/*.html"
            ],
            "eslintConfig": "projects/page-builder/eslint.config.js"
          }
        }
      }
    },
    "website-example": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/website-example",
      "sourceRoot": "projects/website-example/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/website-example/src/main.ts",
            "tsConfig": "projects/website-example/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/website-example/public"
              }
            ],
            "styles": [
              "projects/website-example/src/styles.css"
            ],
            "server": "projects/website-example/src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "projects/website-example/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "website-example:build:production"
            },
            "development": {
              "buildTarget": "website-example:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/website-example/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/website-example/public"
              }
            ],
            "styles": [
              "projects/website-example/src/styles.css"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/website-example/**/*.ts",
              "projects/website-example/**/*.html"
            ],
            "eslintConfig": "projects/website-example/eslint.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "8d2a8b68-3dcc-46ed-8226-1ada949fe036",
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
